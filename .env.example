APP_NAME=Menu-One
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Reverse proxy IPs (comma-separated). Plesk/nginx: 127.0.0.1,::1 — never use *
TRUSTED_PROXIES=127.0.0.1,::1

# --- Plesk üretim (panel.trueddn.com.tr) ---
# 1) Plesk'te MySQL veritabanı oluşturun
# 2) deploy/plesk-panel.env → Plesk .env alanına yapıştırın (DB_* doldurun)
# 3) DB_HOST=localhost kullanın (127.0.0.1 Plesk'te reddedilebilir)
# 4) Sonra composer install çalıştırın
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://panel.trueddn.com.tr
# PANEL_URL=https://panel.trueddn.com.tr
# MAIN_SITE_URL=https://trueddn.com.tr
# MAIL_FROM_ADDRESS=noreply@trueddn.com.tr
# Hazır şablon: deploy/plesk-panel.env

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=menu_one
DB_USERNAME=root
DB_PASSWORD=

# XAMPP varsayılan: root / boş şifre
# Docker: DB_HOST=mariadb, DB_USERNAME=menu_one, DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
ACTIVE_THEME=adminlte4

# Site defaults (used only on first db:seed; panel settings override after that)
PANEL_URL="${APP_URL}"
MAIN_SITE_URL="${APP_URL}"

# Optional platform super admin (created/updated on db:seed when email is set)
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_PASSWORD=
